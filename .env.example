# Mots de passe générés automatiquement — à conserver en lieu sûr
POSTGRES_DB=labe
POSTGRES_USER=labe
POSTGRES_PASSWORD=changez-moi
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=changez-moi
# Premier compte administrateur de l'application (créé au premier démarrage)
APP_ADMIN_EMAIL=admin@exemple.org
APP_ADMIN_PASSWORD=changez-moi
# Envoi des e-mails aux agents (identifiants + lien de validation de l'adresse). Facultatif : sans ces lignes,
# l'administrateur voit le mot de passe temporaire et le lien de validation, et les transmet lui-même.
# Exemple Gmail (mot de passe d'application, pas le mot de passe du compte) :
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=adresse@gmail.com
#SMTP_PASSWORD=mot-de-passe-d-application
#SMTP_FROM=adresse@gmail.com
# Adresse publique du site, pour les liens des e-mails (ex. https://sig-labe.org)
#SITE_URL=https://exemple.org
DB_PORT=5433
WEB_PORT=8080
